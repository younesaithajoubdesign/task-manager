#!/bin/bash
# Starts the app every time you log in to the Mac (a launchd agent).
#
#   bin/autostart install     start at every login (and start it now)
#   bin/autostart uninstall   stop starting at login (servers keep running: bin/tasks stop)

set -eu

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LABEL="local.taskmanager"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
LOGS="$HOME/Library/Logs/TaskManager"

case "${1:-}" in
    install)
        mkdir -p "$HOME/Library/LaunchAgents" "$LOGS"
        cat >"$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>$LABEL</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>$ROOT/bin/tasks</string>
        <string>start</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>AbandonProcessGroup</key>
    <true/>
    <key>StandardOutPath</key>
    <string>$LOGS/autostart.log</string>
    <key>StandardErrorPath</key>
    <string>$LOGS/autostart.log</string>
</dict>
</plist>
PLIST
        launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
        launchctl bootstrap "gui/$(id -u)" "$PLIST"
        echo "Installed: the app starts at every login. Log: $LOGS/autostart.log"
        ;;
    uninstall)
        launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null || true
        rm -f "$PLIST"
        echo "Removed: the app no longer starts at login."
        ;;
    *)
        echo "Usage: bin/autostart [install|uninstall]" >&2
        exit 2
        ;;
esac
