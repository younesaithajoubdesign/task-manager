# Production values for /srv/app/api/.env (DEPLOY.md, step 5).
# Copy this file to api/.env, then replace YOUR-NAME. No secret lives here:
# APP_KEY and APP_PASSWORD_HASH are generated on the server.

APP_NAME=Tasks
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://YOUR-NAME.duckdns.org

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=sqlite
DB_DATABASE=/srv/app/api/database/database.sqlite

SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

BCRYPT_ROUNDS=12

# Set with `php artisan gate:password` — a real password, not 4 characters (§14).
APP_PASSWORD_HASH=
APP_TOKEN_DAYS=90
